# Base URL only -- no version suffix. The client adds the version per endpoint
# (e.g. /v2/tasks/{id}/complete), so a URL ending in /api/v2 doubles the prefix.
PNEUMATIC_API_URL=https://your-instance.pneumatic.app:8001
PNEUMATIC_API_KEY=your-api-key-here
WEBHOOK_PORT=8002
# CONFIG_PATH=/app/config/default.json
